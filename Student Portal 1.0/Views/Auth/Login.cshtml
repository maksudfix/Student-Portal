@using Student_Portal_1._0.Models.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    /* iOS Glassmorphism Card */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 2rem;
        box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.15), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
    }

    /* iOS Glass Inputs */
    .ios-glass-input {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
        color: #ffffff !important;
        border-radius: 1rem !important;
        padding: 0.85rem 1.1rem !important;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

        .ios-glass-input:focus {
            background: rgba(255, 255, 255, 0.16) !important;
            border-color: rgba(56, 189, 248, 0.8) !important;
            box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.2) !important;
            outline: none !important;
        }

        .ios-glass-input::placeholder {
            color: rgba(255, 255, 255, 0.45) !important;
        }

    .ios-glass-label {
        font-weight: 500;
        margin-bottom: 0.4rem;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.875rem;
        letter-spacing: -0.01em;
        display: block;
    }

    /* iOS Glass Alert */
    .ios-glass-alert {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #fca5a5;
        border-radius: 1rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    /* iOS Glass Button with fully rounded pill shape */
    .btn-ios-glass {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.85), rgba(37, 99, 235, 0.85));
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 600;
        border-radius: 50rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }

        .btn-ios-glass:hover {
            background: linear-gradient(135deg, rgba(56, 189, 248, 1), rgba(37, 99, 235, 1));
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
        }

        .btn-ios-glass:active {
            transform: translateY(0);
        }

    /* Footer Prompt */
    .register-prompt {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.9rem;
    }

    .register-link {
        color: #38bdf8;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .register-link:hover {
            color: #7dd3fc;
            text-decoration: underline;
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="ios-glass-card p-4 p-md-5">

                <!-- Header without icon -->
                <div class="mb-4 text-center">
                    <h2 class="fw-bold mb-1 text-white" style="letter-spacing: -0.02em;">Login</h2>
                </div>

                <form asp-controller="Auth" asp-action="Login" method="post">

                    <!-- Glass Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert ios-glass-alert mb-4" role="alert"></div>

                    <!-- Student ID Field -->
                    <div class="mb-3">
                        <label asp-for="StudentId" class="ios-glass-label">Student ID</label>
                        <input asp-for="StudentId"
                               class="form-control ios-glass-input"
                               type="text"
                               placeholder="Enter your Student ID"
                               autocomplete="username" />
                        <span asp-validation-for="StudentId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-4">
                        <label asp-for="Password" class="ios-glass-label"></label>
                        <input asp-for="Password"
                               class="form-control ios-glass-input"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Action Button (Rounded iOS Pill Style) -->
                    <div class="d-grid pt-2">
                        <button type="submit" class="btn btn-ios-glass">
                            Login
                        </button>
                    </div>

                </form>

                <!-- New Student Registration Option -->
                <div class="register-prompt">
                    <span>New Student? </span>
                    <a asp-controller="Auth" asp-action="Register" class="register-link">
                        Register Here
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}