@model IEnumerable<Student_Portal_1._0.Models.ViewModels.StudentRoutineOverviewViewModel>

@{
    ViewData["Title"] = "Class Routine Management";
}

<style>
    /* Glassmorphic Cards & Text Formatting */
    .ios-glass-card,
    .ios-glass-card * {
        color: #ffffff !important;
    }

    .ios-glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 2rem;
        box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.15), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
        overflow: hidden;
    }

    .ios-glass-header {
        background: rgba(255, 255, 255, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
        padding: 1.5rem 2rem;
    }

    .student-card {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        padding: 1.5rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .student-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.16);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
        }

    .badge-id {
        background: rgba(255, 255, 255, 0.25);
        border-radius: 1rem;
        padding: 0.35rem 0.8rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-dept {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        padding: 0.35rem 0.8rem;
        font-size: 0.75rem;
    }

    /* Action Buttons */
    .btn-ios-view {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 0.85rem;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-ios-view:hover {
            background: rgba(255, 255, 255, 0.3);
        }

    .btn-ios-edit {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.9), rgba(37, 99, 235, 0.9));
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 0.85rem;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-ios-edit:hover {
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.4);
        }

    .btn-ios-nav {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 1rem;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-ios-nav:hover {
            background: rgba(255, 255, 255, 0.3);
        }
</style>

<div class="container my-5">
    <div class="ios-glass-card">
        <!-- Banner Header -->
        <div class="ios-glass-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold mb-0">Class Routine Management</h3>
                <p class="small mb-0 opacity-75 mt-1">Manage student course enrollments and weekly class routines</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Course" asp-action="Index" class="btn-ios-nav">
                    <i class="bi bi-journal-bookmark me-1"></i> Course Management
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-ios-nav">
                    <i class="bi bi-house-door me-1"></i> Home
                </a>
            </div>
        </div>

        <!-- Student Cards Grid -->
        <div class="p-4 p-md-5">
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var student in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="student-card">
                                <div>
                                    <!-- Badges -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge-id">ID: @student.StudentId</span>
                                        <span class="badge-dept">@student.Department</span>
                                    </div>

                                    <!-- Student Info -->
                                    <h4 class="fw-bold mb-1">@student.StudentName</h4>
                                    <p class="small opacity-75 mb-4 text-break">@student.Email</p>

                                    <!-- Enrollment Status -->
                                    <div class="mb-4">
                                        <div class="text-uppercase small fw-semibold opacity-75 fs-7">ENROLLED CLASSES:</div>
                                        <div class="fw-bold fs-5">@student.TotalEnrolledClasses Active Slots</div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex gap-2 pt-2">
                                    <a asp-action="Index" asp-route-studentId="@student.StudentInfoId" class="btn-ios-view flex-fill text-center">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                    <a asp-action="EditStudentRoutine" asp-route-studentInfoId="@student.StudentInfoId" class="btn-ios-edit flex-fill text-center">
                                        <i class="bi bi-pencil me-1"></i> Edit Routine
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-4 d-block mb-3 opacity-50"></i>
                    <p class="lead mb-0">No student profiles found.</p>
                </div>
            }
        </div>
    </div>
</div>