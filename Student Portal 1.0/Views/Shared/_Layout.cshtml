<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portal</title>

    <!-- Bootswatch Modern Styling & Icons -->
    <link rel="stylesheet" href="~/lib/bootswatch/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-white min-vh-100 d-flex flex-column">

    <!-- Header (Fixed Height) -->
    <header class="flex-shrink-0">
        <partial name="_Navbar" />
    </header>

    <!-- Main Section -->
    <div class="container-fluid flex-grow-1 d-flex flex-column px-4 my-2 overflow-hidden">

        @{
            // Consume and clear TempData to guarantee single rendering across view & layout
            var successMessage = TempData["SuccessMessage"]?.ToString();
            var errorMessage = TempData["ErrorMessage"]?.ToString();

            TempData.Remove("SuccessMessage");
            TempData.Remove("ErrorMessage");
        }

        <!-- Global Success Notification -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-lg text-white bg-success bg-gradient opacity-90 mb-2 flex-shrink-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Global Error Notification -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-lg text-white bg-danger bg-gradient opacity-90 mb-2 flex-shrink-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Scrollable Content Area -->
        <main role="main" class="flex-grow-1 overflow-auto no-scrollbar pe-1">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top border-white border-opacity-10 footer text-white-50 flex-shrink-0 py-2">
        <div class="container text-center">
            <span class="small">Trex Development</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-info text-decoration-none small ms-2"></a>
        </div>
    </footer>

    <!-- Scripts required for Bootstrap components -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>