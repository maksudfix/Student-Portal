@model Student_Portal_1._0.Models.StudentInfo

@{
    ViewData["Title"] = "Create Student Profile";
}

<style>
    /* Global White Text Enforcements for Forms */
    .ios-glass-card,
    .ios-glass-card *,
    .ios-glass-card input,
    .ios-glass-card textarea,
    .ios-glass-card select,
    .ios-glass-card button,
    .ios-glass-card label,
    .ios-glass-card a,
    .ios-glass-card span,
    .ios-glass-card p,
    .ios-glass-card h1,
    .ios-glass-card h2,
    .ios-glass-card h3,
    .ios-glass-card h4,
    .ios-glass-card h5,
    .ios-glass-card h6 {
        color: #ffffff !important;
    }

    /* iOS Glassmorphism Card Container */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 2rem;
        box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.15), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
        overflow: hidden;
    }

    .ios-glass-header {
        background: rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        padding: 1.25rem 2rem;
    }

    .ios-section-title {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #ffffff !important;
        font-weight: 700;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* iOS Glass Inputs */
    .ios-glass-input {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
        border-radius: 1rem !important;
        padding: 0.85rem 1.1rem !important;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

        .ios-glass-input:focus {
            background: rgba(255, 255, 255, 0.16) !important;
            border-color: rgba(255, 255, 255, 0.8) !important;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2) !important;
            outline: none !important;
            color: #ffffff !important;
        }

        /* White Placeholders across browsers */
        .ios-glass-input::placeholder {
            color: rgba(255, 255, 255, 0.7) !important;
            opacity: 1 !important;
        }

        .ios-glass-input::-webkit-input-placeholder {
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .ios-glass-input::-moz-placeholder {
            color: rgba(255, 255, 255, 0.7) !important;
        }

        .ios-glass-input:-ms-input-placeholder {
            color: rgba(255, 255, 255, 0.7) !important;
        }

    /* Hide Number Input Spinners / Arrows completely */
    .no-spinners::-webkit-outer-spin-button,
    .no-spinners::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .no-spinners {
        -moz-appearance: textfield;
    }

    /* Custom iOS Glass Select Component */
    .ios-select-wrapper {
        position: relative;
        user-select: none;
    }

    .ios-select-trigger {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff !important;
        border-radius: 1rem;
        padding: 0.85rem 1.1rem;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .ios-select-trigger:after {
            content: "";
            width: 0.45em;
            height: 0.45em;
            border-right: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(45deg);
            transition: transform 0.2s ease;
            margin-left: 0.5rem;
        }

    .ios-select-wrapper.open .ios-select-trigger:after {
        transform: rotate(-135deg);
    }

    .ios-select-wrapper.open .ios-select-trigger {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2);
    }

    .ios-select-options {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: rgba(30, 41, 59, 0.85);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        z-index: 100;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ios-select-wrapper.open .ios-select-options {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .ios-option {
        padding: 0.75rem 1.1rem;
        color: #ffffff !important;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

        .ios-option:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff !important;
        }

        .ios-option.selected {
            background: rgba(255, 255, 255, 0.3);
            color: #ffffff !important;
            font-weight: 600;
        }

    .ios-glass-label {
        font-weight: 500;
        margin-bottom: 0.4rem;
        color: #ffffff !important;
        font-size: 0.875rem;
        letter-spacing: -0.01em;
        display: block;
    }

    /* Image Preview Container */
    .ios-preview-container {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 2px dashed rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto 1rem auto;
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
    }

        .ios-preview-container:hover {
            border-color: #ffffff;
            box-shadow: 0 0 25px rgba(255, 255, 255, 0.3);
        }

        .ios-preview-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Action Buttons */
    .btn-ios-primary {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.15));
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 600;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-ios-primary:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.25));
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
        }

    .btn-ios-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 500;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-ios-secondary:hover {
            background: rgba(255, 255, 255, 0.18);
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.4);
        }

    .btn-ios-outline {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        border-radius: 0.75rem;
        transition: all 0.25s ease;
    }

        .btn-ios-outline:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff !important;
        }

    /* Validation Spans forced to White */
    .field-validation-error,
    .validation-summary-errors,
    .text-danger {
        color: #ffffff !important;
        font-weight: 500;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="ios-glass-card">

                <!-- Header -->
                <div class="ios-glass-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h3 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Create Student Profile</h3>
                        <p class="text-white opacity-75 small mb-0">Enter details below to register a new profile</p>
                    </div>
                    <!-- Back Button -->
                    <a asp-action="Index" class="btn btn-ios-secondary btn-sm px-4 rounded-pill d-inline-flex align-items-center justify-content-center ms-auto">
                        Back to List
                    </a>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-white mb-3 small"></div>

                        <!-- Profile Image Section -->
                        <div class="text-center mb-4">
                            <div class="ios-preview-container">
                                <img id="imgPreview"
                                     src="/images/default-avatar.png"
                                     alt="Profile Preview"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/120?text=Avatar';" />
                            </div>
                            <div>
                                <label for="imageInput" class="btn btn-sm btn-ios-outline mb-1 px-3" style="cursor: pointer;">
                                    Upload Profile Photo
                                </label>
                                <input type="file" id="imageInput" name="imageFile" class="d-none" accept="image/*" onchange="previewImage(event)" />
                            </div>
                        </div>

                        <!-- Academic Details Section -->
                        <div class="ios-section-title">Academic Details</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="StudentId" class="ios-glass-label"></label>
                                <!-- type="text" and no-spinners class prevent step increments/arrows -->
                                <input asp-for="StudentId" type="text" class="form-control ios-glass-input no-spinners" />
                                <span asp-validation-for="StudentId" class="text-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Department" class="ios-glass-label"></label>
                                <input asp-for="Department" class="form-control ios-glass-input" />
                                <span asp-validation-for="Department" class="text-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Semester" class="ios-glass-label"></label>
                                <input asp-for="Semester" class="form-control ios-glass-input" />
                                <span asp-validation-for="Semester" class="text-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="ios-glass-label"></label>
                                <!-- Hidden input preserves model binding for ASP.NET Core -->
                                <input type="hidden" asp-for="Gender" id="genderHiddenInput" />

                                <!-- Glassmorphic Custom Dropdown -->
                                <div class="ios-select-wrapper" id="genderDropdown">
                                    <div class="ios-select-trigger" id="genderTrigger">
                                        <span id="genderSelectLabel" class="text-white opacity-75">-- Select Gender --</span>
                                    </div>
                                    <div class="ios-select-options">
                                        <div class="ios-option" data-value="Male">Male</div>
                                        <div class="ios-option" data-value="Female">Female</div>
                                        <div class="ios-option" data-value="Other">Other</div>
                                    </div>
                                </div>
                                <span asp-validation-for="Gender" class="text-white small"></span>
                            </div>
                        </div>

                        <!-- Personal Details Section -->
                        <div class="ios-section-title">Personal Details</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="Name" class="ios-glass-label"></label>
                                <input asp-for="Name" class="form-control ios-glass-input" />
                                <span asp-validation-for="Name" class="text-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="ios-glass-label"></label>
                                <input asp-for="Email" type="email" class="form-control ios-glass-input" />
                                <span asp-validation-for="Email" class="text-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="ios-glass-label"></label>
                                <input asp-for="Phone" class="form-control ios-glass-input" />
                                <span asp-validation-for="Phone" class="text-white small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Address" class="ios-glass-label"></label>
                                <textarea asp-for="Address" class="form-control ios-glass-input" rows="3"></textarea>
                                <span asp-validation-for="Address" class="text-white small"></span>
                            </div>
                        </div>

                        <!-- Form Action Controls -->
                        <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 mt-4 pt-3 border-top border-white border-opacity-10">
                            <a asp-action="Index" class="btn btn-ios-secondary w-100 w-sm-auto text-center px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-ios-primary w-100 w-sm-auto px-5">
                                Save Profile
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imgPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Custom Glassmorphic Select Interaction
        document.addEventListener('DOMContentLoaded', function() {
            const dropdown = document.getElementById('genderDropdown');
            const trigger = document.getElementById('genderTrigger');
            const label = document.getElementById('genderSelectLabel');
            const hiddenInput = document.getElementById('genderHiddenInput');
            const options = dropdown.querySelectorAll('.ios-option');

            // Initialize existing value if re-rendered from model validation error
            if (hiddenInput.value) {
                const selectedOption = dropdown.querySelector(`.ios-option[data-value="${hiddenInput.value}"]`);
                if (selectedOption) {
                    selectedOption.classList.add('selected');
                    label.textContent = selectedOption.textContent;
                    label.classList.remove('opacity-75');
                }
            }

            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
            });

            options.forEach(option => {
                option.addEventListener('click', function() {
                    options.forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');

                    const value = this.getAttribute('data-value');
                    hiddenInput.value = value;
                    label.textContent = this.textContent;
                    label.classList.remove('opacity-75');

                    dropdown.classList.remove('open');
                });
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });
        });
    </script>
}