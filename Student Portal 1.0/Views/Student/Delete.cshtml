@model Student_Portal_1._0.Models.StudentInfo

@{
    ViewData["Title"] = "Delete Student";
}

<style>
    /* iOS Glassmorphism Card Container */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 2rem;
        box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.15), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
        overflow: hidden;
    }

    .ios-glass-header {
        background: rgba(239, 68, 68, 0.15);
        border-bottom: 1px solid rgba(239, 68, 68, 0.3);
        padding: 1.25rem 2rem;
    }

    /* iOS Warning Banner */
    .ios-glass-warning-banner {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: #fef08a;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-radius: 1.25rem;
        padding: 1rem 1.25rem;
    }

    /* Info Field Cards */
    .ios-glass-field {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 1rem;
        padding: 0.85rem 1.1rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        word-break: break-word;
        overflow-wrap: anywhere;
    }

        .ios-glass-field:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.25);
        }

    /* Profile Avatar Glow */
    .avatar-ios-glow {
        border: 3px solid rgba(239, 68, 68, 0.4);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.25);
    }

    .ios-glass-badge {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        font-weight: 500;
    }

    /* iOS Buttons */
    .btn-ios-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.85), rgba(185, 28, 28, 0.85));
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 600;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

        .btn-ios-danger:hover {
            background: linear-gradient(135deg, rgba(239, 68, 68, 1), rgba(185, 28, 28, 1));
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }

    .btn-ios-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 500;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-ios-secondary:hover {
            background: rgba(255, 255, 255, 0.18);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.3);
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="ios-glass-card">

                <!-- Header -->
                <div class="ios-glass-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h3 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Delete Student Profile</h3>
                        <p class="text-white opacity-75 small mb-0">Confirm student record removal</p>
                    </div>
                    <!-- Back Button -->
                    <a asp-action="Index" class="btn btn-ios-secondary btn-sm px-4 rounded-pill d-inline-flex align-items-center justify-content-center ms-auto">
                        Back to List
                    </a>
                </div>

                <!-- Body -->
                <div class="p-4 p-md-5">

                    <!-- Warning Alert -->
                    <div class="ios-glass-warning-banner mb-4 d-flex align-items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                        <div>
                            <strong class="d-block text-white">Warning!</strong>
                            <span class="small opacity-90">Are you sure you want to permanently delete this student record? This action cannot be undone.</span>
                        </div>
                    </div>

                    <div class="row g-4 align-items-center">
                        <!-- Left Column: Student Avatar & Summary -->
                        <div class="col-md-4 text-center border-end border-white border-opacity-10 pe-md-4">
                            <div class="position-relative d-inline-block mb-3">
                                <img src="@(string.IsNullOrEmpty(Model.Image) ? "/images/default-avatar.png" : Model.Image)"
                                     alt="Student Photo"
                                     class="rounded-circle avatar-ios-glow"
                                     style="width: 140px; height: 140px; object-fit: cover;" />
                            </div>
                            <h4 class="fw-bold mb-1 text-white text-break">@Model.Name</h4>
                            <span class="badge ios-glass-badge rounded-pill px-3 py-2 mt-2 text-wrap">
                                @Model.Department
                            </span>
                        </div>

                        <!-- Right Column: Student Details -->
                        <div class="col-md-8 ps-md-4">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="ios-glass-field">
                                        <small class="text-uppercase text-white opacity-50 fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Student ID</small>
                                        <span class="fw-medium text-white d-block text-break">@Model.StudentId</span>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="ios-glass-field">
                                        <small class="text-uppercase text-white opacity-50 fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Semester</small>
                                        <span class="fw-medium text-white d-block text-break">@Model.Semester</span>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="ios-glass-field">
                                        <small class="text-uppercase text-white opacity-50 fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Email</small>
                                        <span class="fw-medium text-white d-block text-break">@Model.Email</span>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="ios-glass-field">
                                        <small class="text-uppercase text-white opacity-50 fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Phone</small>
                                        <span class="fw-medium text-white d-block text-break">@Model.Phone</span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="ios-glass-field">
                                        <small class="text-uppercase text-white opacity-50 fw-semibold d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">Address</small>
                                        <span class="fw-medium text-white d-block text-break">@Model.Address</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Form Actions -->
                    <form asp-action="Delete" method="post" class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 mt-4 pt-4 border-top border-white border-opacity-10">
                        <input type="hidden" asp-for="Id" />

                        <a asp-action="Index" class="btn btn-ios-secondary w-100 w-sm-auto text-center px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-ios-danger w-100 w-sm-auto px-5">
                            Confirm Delete
                        </button>
                    </form>

                </div>

            </div>
        </div>
    </div>
</div>