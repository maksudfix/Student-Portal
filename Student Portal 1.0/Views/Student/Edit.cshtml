@model Student_Portal_1._0.Models.StudentInfo

@{
    ViewData["Title"] = "Edit Student Profile";
}

<style>
    /* iOS Glassmorphism Card Container */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 2rem;
        box-shadow: 0 16px 32px 0 rgba(0, 0, 0, 0.15), inset 0 1px 1px 0 rgba(255, 255, 255, 0.3);
        overflow: hidden;
        color: #ffffff !important;
    }

    .ios-glass-header {
        background: rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        padding: 1.25rem 2rem;
    }

    .ios-section-title {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #ffffff !important;
        font-weight: 700;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* iOS Glass Inputs */
    .ios-glass-input {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.18) !important;
        color: #ffffff !important;
        border-radius: 1rem !important;
        padding: 0.85rem 1.1rem !important;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

        .ios-glass-input:focus {
            background: rgba(255, 255, 255, 0.16) !important;
            border-color: rgba(255, 255, 255, 0.8) !important;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2) !important;
            outline: none !important;
            color: #ffffff !important;
        }

        .ios-glass-input::placeholder {
            color: #ffffff !important;
            opacity: 0.7;
        }

    /* Hide Number Input Spinners / Arrows */
    .no-spinners::-webkit-outer-spin-button,
    .no-spinners::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .no-spinners {
        -moz-appearance: textfield;
    }

    /* Custom iOS Glass Select Component */
    .ios-select-wrapper {
        position: relative;
        user-select: none;
    }

    .ios-select-trigger {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #ffffff !important;
        border-radius: 1rem;
        padding: 0.85rem 1.1rem;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .ios-select-trigger:after {
            content: "";
            width: 0.45em;
            height: 0.45em;
            border-right: 2px solid #ffffff;
            border-bottom: 2px solid #ffffff;
            transform: rotate(45deg);
            transition: transform 0.2s ease;
            margin-left: 0.5rem;
        }

    .ios-select-wrapper.open .ios-select-trigger:after {
        transform: rotate(-135deg);
    }

    .ios-select-wrapper.open .ios-select-trigger {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.8);
        box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2);
    }

    .ios-select-options {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        background: rgba(30, 41, 59, 0.95);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        z-index: 100;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ios-select-wrapper.open .ios-select-options {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .ios-option {
        padding: 0.75rem 1.1rem;
        color: #ffffff !important;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s ease;
    }

        .ios-option:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff !important;
        }

        .ios-option.selected {
            background: rgba(255, 255, 255, 0.3);
            color: #ffffff !important;
            font-weight: 600;
        }

    .ios-glass-label {
        font-weight: 500;
        margin-bottom: 0.4rem;
        color: #ffffff !important;
        font-size: 0.875rem;
        letter-spacing: -0.01em;
        display: block;
    }

    /* Validation Errors in White */
    .text-danger-white {
        color: #ffffff !important;
        text-shadow: 0 0 4px rgba(255, 0, 0, 0.6);
    }

    /* Image Preview Container */
    .ios-preview-container {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        border: 2px dashed rgba(255, 255, 255, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto 1rem auto;
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
    }

        .ios-preview-container:hover {
            border-color: #ffffff;
            box-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
        }

        .ios-preview-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Action Buttons */
    .btn-ios-primary {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.1));
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 600;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

        .btn-ios-primary:hover {
            background: rgba(255, 255, 255, 0.35);
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.3);
        }

    .btn-ios-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-weight: 500;
        border-radius: 1rem;
        padding: 0.85rem 1.5rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-ios-secondary:hover {
            background: rgba(255, 255, 255, 0.18);
            color: #ffffff !important;
            border-color: rgba(255, 255, 255, 0.3);
        }

    .btn-ios-outline {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(10px);
        border-radius: 0.75rem;
        transition: all 0.25s ease;
    }

        .btn-ios-outline:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff !important;
        }
</style>

<div class="container my-5 text-white">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="ios-glass-card">

                <!-- Header -->
                <div class="ios-glass-header d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bold mb-0 text-white" style="letter-spacing: -0.02em;">Edit Student Profile</h3>
                        <p class="text-white small mb-0">Update student information and save changes</p>
                    </div>
                    <!-- Back Button -->
                    <a asp-action="Index" class="btn btn-ios-secondary btn-sm px-3 rounded-pill text-white">
                        Back
                    </a>
                </div>

                <div class="p-4 p-md-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger-white mb-3 small"></div>

                        <!-- Hidden ID & Existing Image Fields for binding -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Image" />

                        <!-- Photo Section -->
                        <div class="text-center mb-4">
                            <div class="ios-preview-container">
                                <img id="imgPreview"
                                     src="@(string.IsNullOrEmpty(Model?.Image) ? "/images/default-avatar.png" : Model.Image)"
                                     alt="Student Photo"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/130?text=Avatar';" />
                            </div>
                            <div>
                                <label for="imageInput" class="btn btn-sm btn-ios-outline mb-1 px-3 text-white" style="cursor: pointer;">
                                    Change Profile Photo
                                </label>
                                <input type="file" id="imageInput" name="imageFile" class="d-none" accept="image/*" onchange="previewImage(event)" />
                            </div>
                        </div>

                        <!-- Academic Details Section -->
                        <div class="ios-section-title">Academic Details</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="StudentId" class="ios-glass-label"></label>
                                <input asp-for="StudentId" type="text" class="form-control ios-glass-input no-spinners" />
                                <span asp-validation-for="StudentId" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Department" class="ios-glass-label"></label>
                                <input asp-for="Department" class="form-control ios-glass-input" />
                                <span asp-validation-for="Department" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Semester" class="ios-glass-label"></label>
                                <input asp-for="Semester" class="form-control ios-glass-input" />
                                <span asp-validation-for="Semester" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="ios-glass-label"></label>
                                <!-- Hidden field ensures exact MVC model binding -->
                                <input type="hidden" asp-for="Gender" id="genderHiddenInput" />

                                <!-- Glassmorphic Custom Select Dropdown -->
                                <div class="ios-select-wrapper" id="genderDropdown">
                                    <div class="ios-select-trigger" id="genderTrigger">
                                        <span id="genderSelectLabel" class="text-white">-- Select Gender --</span>
                                    </div>
                                    <div class="ios-select-options">
                                        <div class="ios-option" data-value="Male">Male</div>
                                        <div class="ios-option" data-value="Female">Female</div>
                                        <div class="ios-option" data-value="Other">Other</div>
                                    </div>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger-white small"></span>
                            </div>
                        </div>

                        <!-- Personal Details Section -->
                        <div class="ios-section-title">Personal Details</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label asp-for="Name" class="ios-glass-label"></label>
                                <input asp-for="Name" class="form-control ios-glass-input" />
                                <span asp-validation-for="Name" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="ios-glass-label"></label>
                                <input asp-for="Email" class="form-control ios-glass-input" />
                                <span asp-validation-for="Email" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="ios-glass-label"></label>
                                <input asp-for="Phone" class="form-control ios-glass-input" />
                                <span asp-validation-for="Phone" class="text-danger-white small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Address" class="ios-glass-label"></label>
                                <textarea asp-for="Address" class="form-control ios-glass-input" rows="3"></textarea>
                                <span asp-validation-for="Address" class="text-danger-white small"></span>
                            </div>
                        </div>

                        <!-- Form Action Controls -->
                        <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 mt-4 pt-3 border-top border-white border-opacity-10">
                            <a asp-action="@(User.IsInRole("Admin") ? "Index" : "Details")" class="btn btn-ios-secondary w-100 w-sm-auto text-center px-4 text-white">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-ios-primary w-100 w-sm-auto px-5 text-white">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const input = event.target;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imgPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Custom iOS Transparent Dropdown Handler
        document.addEventListener('DOMContentLoaded', function() {
            const dropdown = document.getElementById('genderDropdown');
            const trigger = document.getElementById('genderTrigger');
            const label = document.getElementById('genderSelectLabel');
            const hiddenInput = document.getElementById('genderHiddenInput');
            const options = dropdown.querySelectorAll('.ios-option');

            // Pre-select existing value on page edit load
            if (hiddenInput.value) {
                const selectedOption = dropdown.querySelector(`.ios-option[data-value="${hiddenInput.value}"]`);
                if (selectedOption) {
                    selectedOption.classList.add('selected');
                    label.textContent = selectedOption.textContent;
                }
            }

            // Toggle Dropdown Display
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
            });

            // Handle Option Selection
            options.forEach(option => {
                option.addEventListener('click', function() {
                    options.forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');

                    const value = this.getAttribute('data-value');
                    hiddenInput.value = value;
                    label.textContent = this.textContent;

                    dropdown.classList.remove('open');
                });
            });

            // Close menu on click outside
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });
        });
    </script>
}